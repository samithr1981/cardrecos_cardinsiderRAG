# Copy to .streamlit/secrets.toml for local runs (the real file is git-ignored).
# On Streamlit Community Cloud, paste the same line into App settings -> Secrets.
ANTHROPIC_API_KEY = "paste-your-claude-api-key-here"

# Optional: choose the model (default is claude-haiku-5-5; claude-sonnet-5-5 is stronger but costs more).
# CLAUDE_MODEL = "claude-sonnet-5-5"
